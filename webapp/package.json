{
	"name": "dpiapp",
	"version": "1.0.0",
	"main": "server/server.js",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"start": "node server/server.js",
		"dev": "nodemon server/server.js",
		"tests:unit": "mocha --require tests/unit/fixtures.js tests/unit/*.test.js --timeout 5000 --exit",
		"tests:seed": "node tests/e2e/seed.js",
		"tests:load": "npx --yes artillery@2.0.21 run tests/load/loadTest.yml",
		"tests:e2e": "cypress run --config-file tests/e2e/cypress.config.js --spec 'tests/e2e/cypress/e2e/interface.cy.js'",
		"make-admin": "node server/scripts/makeAdmin.js"
	},
	"devDependencies": {
		"chai": "^4.3.6",
		"chai-http": "^4.3.0",
		"cypress": "^10.3.0",
		"mocha": "^11.8.0",
		"nodemon": "^3.1.14"
	},
	"dependencies": {
		"axios": "^1.21.0",
		"bcrypt": "^6.0.0",
		"compression": "^1.8.2",
		"connect-history-api-fallback": "^1.6.0",
		"cors": "^2.8.5",
		"dotenv": "^16.0.1",
		"express": "^4.18.1",
		"express-rate-limit": "^7.5.1",
		"form-data": "^4.0.0",
		"helmet": "^7.2.0",
		"jsonwebtoken": "^9.0.3",
		"mongoose": "^6.4.0",
		"multer": "^2.0.0",
		"nodemailer": "^10.2.1"
	}
}

# MongoDB connection string
MONGODB_URI=mongodb://database:27017/dpiapp

# Public URL of the app (Express serves the SPA and the API); used in verification emails
APP_URL=http://localhost:3000

# Outgoing email (account verification). The Docker stack ships Mailpit, which catches every
# email and shows it at http://localhost:8025; set a real SMTP provider for production.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=DPIApp <no-reply@dpiapp.local>

# JWT signing secret: a random value of at least 32 characters (Express refuses to start with
# this placeholder). For example: openssl rand -hex 32
JWT_SECRET=change_me

# Origins allowed to call the API from a browser (comma-separated; defaults to APP_URL).
# Add http://localhost:8080 when developing with the Vue dev server.
# CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Set when Express runs behind a reverse proxy (number of proxies) so rate limits see the client IP
# TRUST_PROXY=1

# Flask inference server (Express calls /inference, /models... on it). The Docker stacks set it
# to http://flask_api:5000 themselves.
WEB_SERVER_URL=http://localhost:5000

# User the unit, E2E and load tests log in with (created by the tests themselves).
# The username must follow the sign-up rules: 4-20 letters, digits, ".", "_" or "-".
TEST_USER_USERNAME=demouser
TEST_USER_PASSWORD=demopassword

# Mongo Express admin panel credentials (http://localhost:8081, local only). Docker Compose refuses
# to start until the password is set.
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=
